# ──────────────────────────────────────────────
#  Copia este archivo como `.env` y completa los valores.
#  NO subas tu `.env` al repositorio.
# ──────────────────────────────────────────────

# ── Base de datos PostgreSQL ──
# Defaults: jdbc:postgresql://localhost:5432/gestix_db, user=postgres
DB_URL=jdbc:postgresql://localhost:5432/gestix_db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esto

# ── Google OAuth2 ──
# Obténlos en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ── Microsoft OAuth2 (Entra ID) ──
# Obténlos en https://entra.microsoft.com → Registros de aplicaciones
# Redirect URI a registrar en el portal: http://localhost:8080/login/oauth2/code/microsoft
MICROSOFT_CLIENT_ID=tu-client-id-uuid
MICROSOFT_CLIENT_SECRET=tu-client-secret-value

# ── JWT ──
# Debe ser >= 32 caracteres (256 bits) para HS256.
# Genéralo con, por ejemplo:
#   openssl rand -hex 32
JWT_SECRET=genera-una-clave-aleatoria-de-al-menos-64-caracteres-hex
JWT_EXPIRATION=86400000

# ── Servidor (opcional) ──
SERVER_PORT=8080

# ── JPA (opcional, defaults razonables) ──
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ── URL pública de la app (enlaces en correos de recuperación) ──
APP_URL=http://localhost:8080

# ── Email / SMTP ──
# Pon MAIL_ENABLED=true y completa los datos SMTP para enviar correos reales.
# Si MAIL_ENABLED=false, el enlace de recuperacion se imprime en los logs del servidor.
MAIL_ENABLED=false
MAIL_FROM=tu-correo@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
# Gmail: usa una "Contrasena de aplicacion" (no tu contrasena normal)
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
